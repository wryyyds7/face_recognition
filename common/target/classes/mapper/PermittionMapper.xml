    <!-- 新增查询用户角色的方法 -->
    <select id="selectRolesByUserId" resultType="java.lang.String">
        SELECT r.role_key
        FROM sys_user_role ur
                 JOIN sys_role r ON ur.role_id = r.role_id
        WHERE ur.user_id = #{userId}
    </select>
</mapper>